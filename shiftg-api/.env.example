# Copy to .env and fill in. On Railway, set these as Variables (do not commit .env).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
MAX_TOKENS=16000
CORS_ORIGINS=*

# Prompt Meter
PROMPT_METER_MODEL=claude-haiku-4-5

# MongoDB (leads are stored here)
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=...
MONGO_DB=shiftg

# MailerSend (diagnosis email on lead capture). Leave empty to disable email.
MAILERSEND_API_KEY=
MAILERSEND_NO_REPLY_EMAIL=no-reply@yourdomain.com
MAILERSEND_NO_REPLY_NAME=SHIFT+G
